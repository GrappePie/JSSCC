{
  "manifest_version": 3,
  "name": "JSSCC Online Sequencer Bridge",
  "version": "0.1.4",
  "description": "Lets JSSCC search the Online Sequencer catalog through your normal browser session and adds Play Chiptune links to sequence pages.",
  "permissions": ["tabs"],
  "host_permissions": [
    "https://onlinesequencer.net/*",
    "https://grappepie.github.io/JSSCC/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://grappepie.github.io/JSSCC/*"],"js": ["content-jsscc.js"],"run_at": "document_start"},
    {"matches": ["https://onlinesequencer.net/sequences*"],"js": ["content-os.js"],"run_at": "document_idle"},
    {"matches": ["https://onlinesequencer.net/*"],"js": ["content-sequence.js"],"run_at": "document_idle"}
  ]
}
